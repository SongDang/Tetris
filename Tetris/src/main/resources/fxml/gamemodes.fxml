<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="gamemodesPane" fx:controller="com.se330.tetris.controller.GamemodesController"
            prefWidth="1440.0" prefHeight="1024.0" styleClass="screen-gamemodes">

    <Region layoutX="0.0" layoutY="0.0" prefWidth="1440.0" prefHeight="1024.0" styleClass="background-dim" />

    <HBox layoutY="88.0" spacing="98.0" alignment="CENTER"
          AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        <StackPane prefWidth="349.0" prefHeight="664.0">
            <ImageView fx:id="standardCard" fitWidth="349.0" fitHeight="664.0" preserveRatio="false">
                <image>
                    <Image url="@../assets/default_standard.png" />
                </image>
            </ImageView>
        </StackPane>

        <StackPane prefWidth="349.0" prefHeight="664.0">
            <ImageView fx:id="timeCard" fitWidth="349.0" fitHeight="664.0" preserveRatio="false">
                <image>
                    <Image url="@../assets/default_time.png" />
                </image>
            </ImageView>
        </StackPane>

        <StackPane prefWidth="349.0" prefHeight="664.0">
            <ImageView fx:id="hardCard" fitWidth="349.0" fitHeight="664.0" preserveRatio="false">
                <image>
                    <Image url="@../assets/default_hard.png" />
                </image>
            </ImageView>
        </StackPane>
    </HBox>

        <AnchorPane prefHeight="176.0" styleClass="mode-footer"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
        <Region prefHeight="176.0" styleClass="bottom-glow"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" />

        <Button fx:id="backCard" text="Back" onAction="#onBackClicked" layoutX="82.0" layoutY="51.0" prefWidth="148.0" prefHeight="74.0" styleClass="figma-button" />
        </AnchorPane>

</AnchorPane>
