<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="resultsPane" fx:controller="com.se330.tetris.controller.ResultsController"
            prefWidth="1440.0" prefHeight="1024.0" styleClass="screen-results">

    <!-- Lớp phủ nền -->
    <Region prefWidth="1440.0" prefHeight="1024.0" styleClass="background-dim" />

    <!-- LAYOUT CHÍNH 2 CỘT -->
    <HBox layoutX="100.0" layoutY="120.0" spacing="80" alignment="CENTER" prefWidth="1240.0">

        <!-- CỘT TRÁI FINAL SCORE -->
        <VBox spacing="25" alignment="TOP_CENTER" prefWidth="550.0">
            <Label text="GAME OVER" style="-fx-font-size: 60px; -fx-text-fill: #ff4444; -fx-font-weight: bold;"/>

            <VBox spacing="10" alignment="CENTER" style="-fx-background-color: rgba(43, 39, 64, 0.6); -fx-padding: 30; -fx-background-radius: 20; -fx-border-color: #3b3754; -fx-border-radius: 20;">
                <Label text="FINAL SCORE" styleClass="results-title" style="-fx-font-size: 24px;"/>
                <Label fx:id="finalScoreLabel" text="366767" styleClass="results-score" style="-fx-font-size: 85px;"/>

                <Separator opacity="0.2" prefWidth="400"/>

                <GridPane vgap="15" hgap="30" alignment="CENTER">
                    <Label text="MODE:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #8899aa; -fx-font-size: 24px;"/>
                    <Label fx:id="gameModeLabel" text="NORMAL" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                    <Label text="LINES:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #8899aa; -fx-font-size: 24px;"/>
                    <Label fx:id="linesLabel" text="0" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-text-fill: #ffcc00; -fx-font-size: 24px; -fx-font-weight: bold;"/>

                    <Label text="LEVEL:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #8899aa; -fx-font-size: 24px;"/>
                    <Label fx:id="levelLabel" text="1" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-text-fill: #00ff88; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                </GridPane>
            </VBox>

            <!-- KHU VỰC NHẬP TÊN -->
            <VBox fx:id="newRecordBox" spacing="15" alignment="CENTER" style="-fx-border-color: #00ff88; -fx-border-width: 2; -fx-padding: 20; -fx-border-radius: 15; -fx-background-color: rgba(0, 255, 136, 0.05);">
                <Label text="NEW ACHIEVEMENT!" style="-fx-text-fill: #00ff88; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <HBox spacing="15" alignment="CENTER">
                    <TextField fx:id="playerNameInput" promptText="NAME (MAX 9)"
                               prefWidth="220.0" prefHeight="50.0"
                               style="-fx-background-color: #0f0d1a; -fx-text-fill: white; -fx-border-color: #444; -fx-font-size: 18px; -fx-font-family: 'Courier New';"/>
                    <Button fx:id="saveBtn" text="SAVE" onAction="#onSaveClicked"
                            prefWidth="110.0" prefHeight="50.0" styleClass="figma-button" />
                </HBox>
            </VBox>

            <HBox spacing="20" alignment="CENTER">
                <Button fx:id="retryBtn" text="TRY AGAIN" onAction="#onRetryClicked"
                        prefWidth="220.0" prefHeight="60.0" styleClass="figma-button" style="-fx-font-size: 20px;" />

                <Button fx:id="menuBtn" text="MAIN MENU" onAction="#onMenuClicked"
                        prefWidth="220.0" prefHeight="60.0" styleClass="figma-button" style="-fx-font-size: 20px;"
                        visible="true" managed="true"/>
            </HBox>
        </VBox>

        <!-- CỘT PHẢI BẢNG THÀNH TỰU -->
        <VBox spacing="20" alignment="TOP_CENTER" prefWidth="600.0"
              style="-fx-background-color: rgba(15, 13, 26, 0.85); -fx-padding: 40; -fx-border-color: #2b2740; -fx-border-radius: 20; -fx-background-radius: 20;">

            <Label text="HALL OF FAME" style="-fx-font-size: 36px; -fx-text-fill: #00ff88; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>

            <TableView fx:id="highScoreTable" prefHeight="450.0" prefWidth="520.0"
                       style="-fx-background-color: transparent; -fx-font-family: 'Courier New'; -fx-font-size: 18px;">
                <columns>
                    <TableColumn fx:id="colName" text="PLAYER" prefWidth="160.0" />
                    <TableColumn fx:id="colScore" text="SCORE" prefWidth="160.0" />
                    <TableColumn fx:id="colDate" text="DATE" prefWidth="200.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Hyperlink fx:id="resetAllBtn" text="Reset all scores" onAction="#onResetAllClicked"
                       style="-fx-text-fill: #ff4444; -fx-font-family: 'Courier New'; -fx-font-size: 16px; -fx-underline: true; -fx-border-color: transparent;" />
        </VBox>
    </HBox>

    <!-- Asset Giao diện cũ -->
    <Region layoutY="848.0" prefWidth="1440.0" prefHeight="176.0" styleClass="bottom-glow" />
    <StackPane layoutX="417.5" layoutY="910.0" prefWidth="605.0" prefHeight="60.0" styleClass="results-note-panel">
        <Label fx:id="commentLabel" text="Not bad, but you can do better" styleClass="results-note-text" />
    </StackPane>

</AnchorPane>
