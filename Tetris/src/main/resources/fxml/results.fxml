<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:id="resultsPane" fx:controller="com.se330.tetris.controller.ResultsController"
            prefWidth="1440.0" prefHeight="1024.0" styleClass="screen-results">

    <Region layoutX="0.0" layoutY="0.0" prefWidth="1440.0" prefHeight="1024.0"
            styleClass="background-dim" mouseTransparent="true" />

    <Label fx:id="titleLabel" layoutX="559.0" layoutY="215.0" prefWidth="337.0" prefHeight="76.0"
           text="FINAL SCORE:" styleClass="results-title" />

    <Label fx:id="finalScoreLabel" layoutX="559.0" layoutY="267.0" prefWidth="337.0" prefHeight="122.0"
           text="366767" styleClass="results-score" />

    <Button fx:id="saveBtn" onAction="#onSaveClicked" text="Save score"
            layoutX="576.0" layoutY="467.0" prefWidth="291.0" prefHeight="74.0"
            styleClass="figma-button" />

    <Button fx:id="retryBtn" onAction="#onRetryClicked" text="Retry"
            layoutX="574.0" layoutY="599.0" prefWidth="291.0" prefHeight="74.0"
            styleClass="figma-button" />

    <Region layoutX="0.0" layoutY="848.0" prefWidth="1440.0" prefHeight="176.0" styleClass="bottom-glow" />

    <StackPane fx:id="notePanel" layoutX="425.0" layoutY="893.0" prefWidth="605.0" prefHeight="86.0" styleClass="results-note-panel">
        <Label fx:id="noteLabel" text="Not bad, but you can do better" styleClass="results-note-text" />
    </StackPane>

    <Button fx:id="menuBtn" text="Back" onAction="#onMenuClicked" visible="false" managed="false" />

    <Label fx:id="gameModeLabel" visible="false" managed="false" text="Mode" />
    <Label fx:id="timeLabel" visible="false" managed="false" text="Time: 0:00" />
    <Label fx:id="linesLabel" visible="false" managed="false" text="0" />
    <Label fx:id="levelLabel" visible="false" managed="false" text="0" />
    <Label fx:id="blocksLabel" visible="false" managed="false" text="0" />

</AnchorPane>
