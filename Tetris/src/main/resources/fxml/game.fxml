<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="gamePane"
      fx:controller="com.se330.tetris.controller.GameController"
      focusTraversable="true"
      style="-fx-background-color: #0f0d1a; -fx-padding: 20; -fx-spacing: 20; -fx-alignment: center;">

    <VBox style="-fx-alignment: center; -fx-spacing: 16; -fx-min-width: 150;">

        <VBox style="-fx-alignment: center; -fx-spacing: 8; -fx-padding: 14; -fx-border-color: #334455; -fx-background-color: #1a1830; -fx-background-radius: 4;">
            <Label text="HOLD" style="-fx-text-fill: #8899aa; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Canvas fx:id="holdBlockCanvas" width="100" height="100"/>
        </VBox>

        <VBox style="-fx-alignment: center; -fx-spacing: 6; -fx-padding: 14; -fx-border-color: #334455; -fx-background-color: #1a1830; -fx-background-radius: 4;">
            <Label text="SCORE" style="-fx-text-fill: #8899aa; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="scoreLabel" text="0" style="-fx-font-size: 26; -fx-text-fill: #ffffff; -fx-font-family: 'Courier New';"/>
        </VBox>

        <VBox style="-fx-alignment: center; -fx-spacing: 6; -fx-padding: 14; -fx-border-color: #334455; -fx-background-color: #1a1830; -fx-background-radius: 4;">
            <Label text="LEVEL" style="-fx-text-fill: #8899aa; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="levelLabel" text="1" style="-fx-font-size: 26; -fx-text-fill: #00ff88; -fx-font-family: 'Courier New';"/>
        </VBox>

        <VBox style="-fx-alignment: center; -fx-spacing: 6; -fx-padding: 14; -fx-border-color: #334455; -fx-background-color: #1a1830; -fx-background-radius: 4;">
            <Label text="LINES" style="-fx-text-fill: #8899aa; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="linesLabel" text="0" style="-fx-font-size: 26; -fx-text-fill: #ffcc00; -fx-font-family: 'Courier New';"/>
        </VBox>
    </VBox>

    <VBox style="-fx-alignment: center; -fx-spacing: 10;">
        <StackPane style="-fx-border-color: #00ff00; -fx-border-width: 2;">
            <Canvas fx:id="gameCanvas" width="300" height="600"/>
            <Canvas fx:id="vfxCanvas" width="600" height="600" managed="false" layoutX="-150" mouseTransparent="true"/>
        </StackPane>

        <HBox style="-fx-alignment: center; -fx-padding: 8 0 0 0;">
            <Label text="← →: Move | ↑: Rotate | B: Bomb | C: Hold | SPACE: Drop | P: Pause"
                   style="-fx-font-size: 10; -fx-text-fill: #666688; -fx-font-family: 'Courier New';"/>
        </HBox>
    </VBox>

    <VBox style="-fx-alignment: center; -fx-spacing: 16; -fx-min-width: 150;">
        <VBox style="-fx-alignment: center; -fx-spacing: 8; -fx-padding: 14; -fx-border-color: #334455; -fx-background-color: #1a1830; -fx-background-radius: 4;">
            <Label text="NEXT" style="-fx-text-fill: #8899aa; -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Canvas fx:id="nextBlockCanvas1" width="100" height="100"/>
            <Canvas fx:id="nextBlockCanvas2" width="100" height="100"/>
            <Canvas fx:id="nextBlockCanvas3" width="100" height="100"/>
        </VBox>

        <VBox fx:id="bombInventoryBox"
              style="-fx-alignment: center; -fx-spacing: 8; -fx-padding: 14;
                     -fx-border-color: #aa3344; -fx-border-width: 1;
                     -fx-background-color: #2a1620; -fx-background-radius: 4;">
            <Label text="BOMB SKILL"
                   style="-fx-font-size: 11; -fx-text-fill: #ff9aa8;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="bombsLabel" text="💣 x3"
                   style="-fx-font-size: 24; -fx-text-fill: #ff5566;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
        </VBox>
    </VBox>
</HBox>