<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:id="gamePane"
      fx:controller="com.se330.tetris.controller.GameController"
      focusTraversable="true"
      style="-fx-background-color: #0f0d1a; -fx-padding: 20; -fx-spacing: 20; -fx-alignment: center;">

    <!-- ── Board ─────────────────────────────────────────────────────────── -->
    <VBox style="-fx-alignment: center; -fx-spacing: 0;">
        <!-- Wrap Canvas trong StackPane để -fx-border-color hoạt động -->
        <StackPane style="-fx-border-color: #00ff00; -fx-border-width: 2;">
            <Canvas fx:id="gameCanvas" width="300" height="600"/>
        </StackPane>

        <!-- Hint bar nằm ngay dưới board, cùng chiều rộng -->
        <HBox style="-fx-alignment: center; -fx-padding: 8 0 0 0;">
                                                                       <Label text="← → : Di chuyển  |  ↑ : Xoay  |  B : Bom  |  C/SHIFT : Hold  |  SPACE : Drop  |  P : Tạm dừng"
                   style="-fx-font-size: 11; -fx-text-fill: #666688; -fx-font-family: 'Courier New';"/>
        </HBox>
    </VBox>

    <!-- ── Side panel ────────────────────────────────────────────────────── -->
    <VBox style="-fx-alignment: center; -fx-spacing: 16; -fx-min-width: 160;">

        <!-- Score -->
        <VBox style="-fx-alignment: center; -fx-spacing: 6; -fx-padding: 14;
                     -fx-border-color: #334455; -fx-border-width: 1;
                     -fx-background-color: #1a1830; -fx-background-radius: 4;
                     -fx-border-radius: 4;">
            <Label text="SCORE"
                   style="-fx-font-size: 11; -fx-text-fill: #8899aa;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="scoreLabel" text="0"
                   style="-fx-font-size: 26; -fx-text-fill: #ffffff;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Level -->
        <VBox style="-fx-alignment: center; -fx-spacing: 6; -fx-padding: 14;
                     -fx-border-color: #334455; -fx-border-width: 1;
                     -fx-background-color: #1a1830; -fx-background-radius: 4;
                     -fx-border-radius: 4;">
            <Label text="LEVEL"
                   style="-fx-font-size: 11; -fx-text-fill: #8899aa;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="levelLabel" text="1"
                   style="-fx-font-size: 26; -fx-text-fill: #00ff88;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Lines -->
        <VBox style="-fx-alignment: center; -fx-spacing: 6; -fx-padding: 14;
                     -fx-border-color: #334455; -fx-border-width: 1;
                     -fx-background-color: #1a1830; -fx-background-radius: 4;
                     -fx-border-radius: 4;">
            <Label text="LINES"
                   style="-fx-font-size: 11; -fx-text-fill: #8899aa;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="linesLabel" text="0"
                   style="-fx-font-size: 26; -fx-text-fill: #ffcc00;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
        </VBox>

        <!-- Next piece preview -->
        <VBox style="-fx-alignment: center; -fx-spacing: 8; -fx-padding: 14;
                     -fx-border-color: #334455; -fx-border-width: 1;
                     -fx-background-color: #1a1830; -fx-background-radius: 4;
                     -fx-border-radius: 4;">
            <Label text="NEXT"
                   style="-fx-font-size: 11; -fx-text-fill: #8899aa;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <!-- Wrap Canvas trong StackPane để border hoạt động -->
            <StackPane style="-fx-border-color: #334455; -fx-border-width: 1;">
                <Canvas fx:id="nextBlockCanvas" width="180" height="180"/>
            </StackPane>
        </VBox>

              <!-- Hold piece preview -->
              <VBox style="-fx-alignment: center; -fx-spacing: 8; -fx-padding: 14;
                                    -fx-border-color: #334455; -fx-border-width: 1;
                                    -fx-background-color: #1a1830; -fx-background-radius: 4;
                                    -fx-border-radius: 4;">
                     <Label text="HOLD"
                               style="-fx-font-size: 11; -fx-text-fill: #8899aa;
                                            -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
                     <StackPane style="-fx-border-color: #334455; -fx-border-width: 1;">
                            <Canvas fx:id="holdBlockCanvas" width="180" height="180"/>
                     </StackPane>
              </VBox>

        <!-- Bomb inventory -->
        <VBox fx:id="bombInventoryBox"
              style="-fx-alignment: center; -fx-spacing: 8; -fx-padding: 14;
                     -fx-border-color: #aa3344; -fx-border-width: 1;
                     -fx-background-color: #2a1620; -fx-background-radius: 4;
                     -fx-border-radius: 4;">
            <Label text="BOMB"
                   style="-fx-font-size: 11; -fx-text-fill: #ff9aa8;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
            <Label fx:id="bombsLabel" text="💣 x3"
                   style="-fx-font-size: 24; -fx-text-fill: #ff5566;
                          -fx-font-family: 'Courier New'; -fx-font-weight: bold;"/>
        </VBox>

    </VBox>
</HBox>
